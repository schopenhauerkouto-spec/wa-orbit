# WA Orbit control plane (Express dashboard/API)
ORBIT_API_URL=https://your-wa-orbit-server.example.com
BAILEYS_CONNECTOR_TOKEN=replace-with-the-same-long-random-secret-configured-on-the-WA-Orbit-server

# Optional: Cloudflare Worker connector (separate official transport)
ADMIN_API_TOKEN=replace-with-the-worker-admin-secret

# WhatsApp Business Platform (official Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0

# Action worker
ORBIT_BATCH_SIZE=5
ORBIT_MIN_DELAY_MS=30000
ORBIT_POLL_INTERVAL_MS=60000

# Baileys personal/group connector
BAILEYS_ENABLED=false
BAILEYS_AUTH_DIR=./data/baileys-auth
BAILEYS_PAIRING_NUMBER=
# Optional fallback only. You can choose QR or number pairing directly in the dashboard.
BAILEYS_GROUP_ENFORCEMENT=false
BAILEYS_CONNECTOR_TOKEN=
BAILEYS_CONTROL_POLL_MS=30000
