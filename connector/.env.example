# Cloudflare Worker
ORBIT_API_URL=https://your-worker.your-subdomain.workers.dev
ADMIN_API_TOKEN=replace-with-the-same-long-random-secret-as-worker

# Baileys / WhatsApp personnel
# E.164 digits only, without +, spaces or punctuation. Optional: if empty, use the QR flow.
BAILEYS_PHONE_NUMBER=
# Persistent directory for the WhatsApp authentication state.
# On Render, mount a persistent disk at this path; never commit this directory.
BAILEYS_AUTH_DIR=./.baileys-auth

# Action worker
ORBIT_BATCH_SIZE=5
ORBIT_MIN_DELAY_MS=30000
ORBIT_POLL_INTERVAL_MS=60000
