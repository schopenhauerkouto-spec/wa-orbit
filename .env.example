# WA Orbit — copie ce fichier vers .env pour un lancement local.
# Ne partage jamais .env et ne committe jamais ses secrets.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Connexion au tableau de bord (change impérativement ces deux valeurs)
ADMIN_PASSWORD=remplace-par-un-mot-de-passe-unique-de-16-caracteres-minimum
SESSION_SECRET=remplace-par-une-cle-aleatoire-cryptographiquement-forte-de-32-caracteres-minimum

# Stockage : vide en local = data/db.json. Sur Render, configure DATABASE_URL.
DATABASE_URL=
REQUIRE_DATABASE=false

# Meta > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Renseigne une version Graph API actuellement prise en charge par Meta, ex. vNN.N
WHATSAPP_API_VERSION=
# App settings > Basic > App Secret (signature du webhook)
WHATSAPP_APP_SECRET=
# Secret que TU choisis puis recopies dans la configuration du webhook Meta
WHATSAPP_VERIFY_TOKEN=choisis-un-secret-webhook-long-et-aleatoire

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=160

# Protection locale du Free Tier Groq : marge de sécurité sous les plafonds publics.
# Les limites de ton organisation dans la console Groq restent la référence définitive.
GROQ_FREE_TIER_MODE=true
GROQ_FREE_RPM=25
GROQ_FREE_RPD=900
GROQ_FREE_TPM=7000
GROQ_FREE_TPD=180000

# Bot conversationnel — laisse désactivé jusqu'à la validation complète du webhook.
BOT_AUTO_REPLY_ENABLED=false
BOT_MAX_AUTO_REPLIES_PER_DAY=50
BOT_MAX_REPLIES_PER_CONTACT_PER_HOUR=3
BOT_PERSONA=Tu es un assistant WhatsApp utile, poli et naturel. Tu réponds en français simple.
BOT_BUSINESS_CONTEXT=Je suis un assistant général. Je peux répondre aux questions et demander des précisions si nécessaire.
